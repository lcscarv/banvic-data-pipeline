# Copie para .env e preencha. Nunca commite o .env.
# Senhas e chaves: `openssl rand -hex 16` (ou 32), exceto onde indicado.

# Warehouse: superusuário, usado só pelo container do Postgres e por `make db-roles`
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=banvic
POSTGRES_HOST=postgres.banvic.svc.cluster.local
POSTGRES_PORT=5432

# Roles do warehouse (menor privilégio)
MELTANO_DB_PASSWORD=
ANALYST_DB_PASSWORD=
# Salt do hash de dados pessoais (LGPD)
MELTANO_HASH_SEED=

AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# Airflow: banco de metadados e chaves
AIRFLOW_METADATA_DB_PASSWORD=
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
